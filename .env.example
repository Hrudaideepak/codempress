# Codempress Global Environment Variables Configuration

# --- FastAPI Backend Settings ---
ENV=development
PROD=false
JWT_SECRET=codempress_super_secret_jwt_key_2026
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase Database Integration ---
USE_SUPABASE=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
POSTGRES_URL=postgresql://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- AI Content Generation ---
GITHUB_TOKEN=your_github_token_here
